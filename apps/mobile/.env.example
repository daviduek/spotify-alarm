# Copy to .env (gitignored). EXPO_PUBLIC_* values are inlined into the JS bundle.
#
# Spotify Client ID — PUBLIC, from https://developer.spotify.com/dashboard
#   Redirect URI to register there:  wake://spotify-callback
#   APIs: Web API. Bundle id / package: com.daviduek.wake (and com.daviduek.wake.dev)
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# Feature flags (spec §63). "true" / "false".
EXPO_PUBLIC_FLAG_SPOTIFY=true
EXPO_PUBLIC_FLAG_RECORDINGS=true
EXPO_PUBLIC_FLAG_DIAGNOSTICS=true
