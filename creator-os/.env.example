# Creator OS Alpha — environment template.
# Copy to .env:  cp .env.example .env

# App
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
SECRET_KEY=change-me
JWT_SECRET=change-me

# Database
DATABASE_URL=postgresql+psycopg://creator_os:creator_os@localhost:5432/creator_os

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage (S3-compatible; MinIO locally)
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=creator-os-assets
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/creator-os-assets

# Provider mode: mock | google / buffer / posthog (real providers are future work)
GENERATION_PROVIDER=mock
PUBLISHING_PROVIDER=mock
ANALYTICS_PROVIDER=mock

# Google generation (leave empty in Alpha; mock provider is used)
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=
GOOGLE_VIDEO_MODEL=

# Buffer (leave empty in Alpha; mock provider is used)
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=

# PostHog
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Tracking
TRACKING_BASE_URL=http://localhost:8000/go
DEFAULT_LINKTREE_URL=https://linktr.ee/

# Operator seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
