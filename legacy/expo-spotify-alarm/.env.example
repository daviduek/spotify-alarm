# Copy this file to .env and fill in your real Spotify Client ID.
# .env is gitignored — never commit it.
#
# How to get your Client ID:
#   1. Go to https://developer.spotify.com/dashboard
#   2. Click "Create app"
#       Name:             Spotify Alarm (or anything)
#       App description:  Wake-up alarm
#       Redirect URI:     spotifyalarm://callback
#       APIs/SDKs:        check "Web API"
#   3. Save → copy the "Client ID" from the app's overview page
#
# Variables prefixed with EXPO_PUBLIC_ are automatically inlined into the
# JS bundle at build time. The Client ID is PUBLIC (safe to ship) because
# we use PKCE — there is no client secret.

EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your_client_id_here
